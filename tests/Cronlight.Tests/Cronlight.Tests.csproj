<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="coverlet.collector" Version="10.1.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <!-- Patched versions of vulnerable transitive dependencies (SqlClient, Microsoft.Data.Sqlite) -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
    <PackageReference Include="MySqlConnector" Version="2.6.2" />
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.85" />
    <!-- The latest 3.x, above the 3.13.1 the packages need: build/smoke-test.sh covers that one -->
    <PackageReference Include="Quartz" Version="3.22.7" />
    <PackageReference Include="Quartz.Extensions.Hosting" Version="3.22.7" />
    <PackageReference Include="Quartz.Serialization.Json" Version="3.22.7" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.13" />
    <!-- Test hosts with an OpenAPI document of their own reference it as such a host would, with its build settings -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Cronlight\Cronlight.csproj" />
    <ProjectReference Include="..\..\src\Cronlight.History\Cronlight.History.csproj" />
    <ProjectReference Include="..\QuartzSample.Jobs\QuartzSample.Jobs.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\samples\Cronlight.SampleHost\tables_sqlite.sql" Link="tables_sqlite.sql" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Schemas\*.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
