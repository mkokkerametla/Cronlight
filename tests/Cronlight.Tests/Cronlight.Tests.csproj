<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Both frameworks the packages ship for -->
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <!-- One framework at a time: both share the test databases, and each run recreates the Quartz tables -->
    <TestTfmsInParallel>false</TestTfmsInParallel>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <!-- Patched versions of vulnerable transitive dependencies (SqlClient, Microsoft.Data.Sqlite) -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
    <PackageReference Include="MySqlConnector" Version="2.6.2" />
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.85" />
    <PackageReference Include="Quartz.Extensions.Hosting" Version="3.13.1" />
    <PackageReference Include="Quartz.Serialization.Json" Version="3.13.1" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="8.0.32" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Cronlight\Cronlight.csproj" />
    <ProjectReference Include="..\..\src\Cronlight.History\Cronlight.History.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\samples\Cronlight.SampleHost\tables_sqlite.sql" Link="tables_sqlite.sql" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Schemas\*.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
